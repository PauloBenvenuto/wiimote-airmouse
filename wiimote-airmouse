    "clutch": "Freeze cursor", "cleartext": "Clear text", "wsdrag": "Drag window to workspace",
    "keyboard": "On-screen keyboard", "none": "",
}
BUTTON_ORDER = ["a", "b", "one", "two", "plus", "minus", "home", "up", "down", "left", "right"]


def action_label(spec, labels):
    spec = str(spec)
    if spec in labels:
        return str(labels[spec])
    if spec in SPECIAL_NAMES:
        return SPECIAL_NAMES[spec]
    kind, _, arg = spec.partition(":")
    arg = arg.strip()

    def combo(text):
        return "+".join(KEY_NAMES.get(k.strip(), k.strip().split("_", 1)[-1].title()) for k in text.split("+"))

    if kind in ("key", "button", "pad"):
        return combo(arg)
    if kind == "keys":
        return ", ".join(combo(c) for c in arg.split(","))
    if kind == "profile":
        return {"next": "Next profile", "prev": "Previous profile"}.get(arg, f"{arg} profile")
    if kind == "exec":
        return f"Run {Path(arg.split()[0]).name}"
    return arg


def describe(cfg):
    """Mapa de botones de cada perfil en JSON, para que una interfaz lo muestre."""
    labels = cfg["labels"]
    try:
        current = STATE.read_text().strip()
    except OSError:
        current = ""
    profiles = []
    for prof in cfg["profile_list"]:
        buttons, hold = prof["specs"]
        rows = [{"button": b, "press": action_label(buttons.get(b, "none"), labels),
                 "hold": action_label(hold.get(b, "none"), labels)} for b in BUTTON_ORDER]
        rows += [{"button": b, "press": action_label(spec, labels), "hold": ""}
                 for b, spec in buttons.items() if "+" in b]
        profiles.append({"name": prof["name"], "buttons": rows})
    print(json.dumps({"current": current, "profiles": profiles}, ensure_ascii=False))


def hypr_signature():
    """Instancia de Hyprland en marcha (la del entorno si sigue viva; si no, la más reciente)."""
    base = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr"
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig and (base / sig / ".socket.sock").exists():
        return sig
    socks = sorted(base.glob("*/.socket.sock"), key=lambda s: s.stat().st_mtime, reverse=True)
    return socks[0].parent.name if socks else None


def hypr_request(cmd):
    """Petición al socket de Hyprland (como hyprctl, sin lanzar procesos); None si no hay sesión."""
    sig = hypr_signature()
    if not sig:
        return None
    path = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr" / sig / ".socket.sock"
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(1)
            s.connect(str(path))
            s.sendall(cmd.encode())
            chunks = []
            while chunk := s.recv(65536):
                chunks.append(chunk)
            return b"".join(chunks).decode(errors="replace").strip()
    except OSError:
        return None


def desktop_width():
    """Ancho lógico de todo el escritorio (de borde a borde de los monitores), o None."""
    try:
        monitors = json.loads(hypr_request("j/monitors") or "")
    except ValueError:
        return None
    edges = []
    for m in monitors:
        w = (m["height"] if m.get("transform", 0) % 2 else m["width"]) / (m.get("scale") or 1)
        edges.append((m["x"], m["x"] + w))
    return max(r for _, r in edges) - min(l for l, _ in edges) if edges else None


def theme_exists(theme):
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    return any((d / theme / "cursors").is_dir() for d in (data / "icons", Path.home() / ".icons",
                                                         Path("/usr/share/icons")))


def normal_cursor(wii_theme):
    """Tema de cursor normal: el de gsettings (lo pone el Control Center, scripts/look). Hyprland
    copia a gsettings el tema de setcursor, así que si ya dice el tema Wii se usa el de la config
    de Hyprland (modules/menu-look.lua o el estilo) o, sin elegir, "default"."""
    try:
        res = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"],
                             capture_output=True, text=True, timeout=2)
        theme = res.stdout.strip().strip("'")
    except (OSError, subprocess.TimeoutExpired):
        theme = ""
    if not theme or theme == wii_theme:
        hypr = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypr"
        theme = "default"
        for f in (hypr / "modules/menu-look.lua", hypr / "generated/estilo.lua"):
            m = re.search(r'cursor_theme\s*=\s*"([^"]+)"', f.read_text()) if f.is_file() else None
            if m:
                theme = m.group(1)
                break
    return theme


def run_command(cmd):
    # Vía Hyprland: el comando hereda el entorno de la sesión aunque el servicio arrancara antes
    sig = hypr_signature()
    if sig:
        env = dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=sig)
        res = subprocess.run(["hyprctl", "dispatch", f"hl.dsp.exec_cmd([==[{cmd}]==])"],
                             env=env, capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip() == "ok":
            return
        log(f"hyprctl failed ({(res.stdout + res.stderr).strip()}), running directly")
    subprocess.Popen(cmd, shell=True, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ui_call(cfg, *args):
    """Orden a la interfaz externa ([ui] ipc + objetivo + función); nada si no hay interfaz."""
    if cfg["ui"]["ipc"]:
        subprocess.Popen(shlex.split(cfg["ui"]["ipc"]) + list(args),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def keyboard_send(cmd):
    """Orden al teclado en pantalla (wii-keyboard), si está en marcha."""
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(0.2)
            s.connect(str(KEYBOARD_SOCK))
            s.sendall(json.dumps({"cmd": cmd}).encode() + b"\n")
    except OSError:
        pass


def find_wiimotes():
    """{carpeta sysfs del HID: {papel: InputDevice}} de los Wiimote conectados."""
    groups = {}
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        role = ROLES.get(dev.name)
        if not role:
            dev.close()
            continue
        hid = os.path.realpath(f"/sys/class/input/{Path(path).name}/device/device")
        groups.setdefault(hid, {})[role] = dev
    return groups


class Pointer:
    """Giroscopio → movimiento relativo, con offset calibrado en reposo."""

    def __init__(self, cfg, debug):
        self.cfg, self.debug = cfg, debug
        self.px_per_deg = None  # con pointer.span: ancho del escritorio / span
        self.clutch = False     # embrague: el cursor no se mueve (recolocar la muñeca)
        self.reset()

    def reset(self):
        try:
            self.bias = [float(v) for v in BIAS.read_text().split()][:2] or None
        except (OSError, ValueError):
            self.bias = None
        self.bias_saved = time.monotonic()  # se guarda en reposos ya confirmados, no al calibrar
        self.stable_since = None  # estable pero lejos del offset desde (timestamp del informe)
        self.gyro = {e.ABS_RX: 0, e.ABS_RY: 0, e.ABS_RZ: 0}
        self.accel = {e.ABS_RX: 0, e.ABS_RY: 0, e.ABS_RZ: 0}
        self.window = deque()  # (t, (gx, gy, ax, ay, az))
        self.sums = [0] * 5
        self.sqsums = [0] * 5
        self.last_t = None
        self.dps = [0.0, 0.0]   # giro filtrado (°/s)
        self.vel = [0.0, 0.0]   # px/s
        self.frac = [0.0, 0.0]
        self.period = 0.01      # intervalo medio entre informes (~100 Hz)
        self.last_report = 0.0  # monotonic del último informe con movimiento
        self.last_step = 0.0
        self.resting = False
        self.rest_since = None  # monotonic desde que está en reposo (para dormir el mando)
        self.last_debug = 0.0

    def save_bias(self):
        self.bias_saved = time.monotonic()
        try:
            BIAS.parent.mkdir(parents=True, exist_ok=True)
            BIAS.write_text(f"{self.bias[0]:.1f} {self.bias[1]:.1f}\n")
        except OSError as err:
            log(f"Could not save the gyro offset: {err}")

    def add_sample(self, sample, sign):
        for i, v in enumerate(sample):
            self.sums[i] += sign * v
            self.sqsums[i] += sign * v * v

    def on_accel(self, ev):
        if ev.type == e.EV_ABS:
            self.accel[ev.code] = ev.value

    @property
    def moving(self):
        return self.vel != [0.0, 0.0]

    def on_gyro(self, ev):
        """Actualiza la velocidad del cursor al cerrar cada informe (SYN_REPORT); el movimiento
        lo emite step() a ritmo fijo."""
        if ev.type == e.EV_ABS:
            self.gyro[ev.code] = ev.value
            return
        if ev.type != e.EV_SYN:
            return
        p, r = self.cfg["pointer"], self.cfg["rest"]
        t = ev.timestamp()
        # Los informes llegan a ráfagas por Bluetooth (0–30 ms entre ellos) aunque el mando los
        # mide a ritmo fijo: el filtro usa el intervalo medio, no el de cada uno
        if self.last_t:
            self.period += 0.02 * (min(max(t - self.last_t, 0.0), 0.05) - self.period)
        self.last_t = t
        raw = (self.gyro[e.ecodes[p["x_axis"]]], self.gyro[e.ecodes[p["y_axis"]]])

        # Reposo: giro y acelerómetro estables en toda la ventana
        # (sumas y sumas de cuadrados acumuladas: valores enteros, exactas y sin recorrer la ventana)
        sample = (*raw, *self.accel.values())
        self.window.append((t, sample))
        self.add_sample(sample, 1)
        while t - self.window[0][0] > r["window_ms"] / 1000:
            self.add_sample(self.window.popleft()[1], -1)
        n = len(self.window)
        full = n >= 10 and t - self.window[0][0] >= r["window_ms"] / 1000 * 0.9
        if full:
            mean = [s / n for s in self.sums]
            sd = [math.sqrt(max(q / n - m * m, 0.0)) for q, m in zip(self.sqsums, mean)]
            gyro_sd = max(sd[:2]) / UNITS_PER_DPS
            accel_sd = max(sd[2:])
            # Primera calibración sin offset guardado: umbrales más holgados, para que baste con
            # sujetar el mando quieto en la mano (luego se afina en cada reposo)
            k = 1 if self.bias is not None else 2
            resting = gyro_sd < r["gyro_threshold"] * k and accel_sd < r["accel_threshold"] * k
            # Un giro constante (yaw a velocidad fija) también es "estable": solo es reposo si
            # la media está cerca del offset ya calibrado
            # (salvo que siga estable 3 s: nadie gira tan parejo tanto rato, así que el offset
            # estaba mal, p. ej. el guardado de otro mando, y se recalibra)
            if not resting:
                self.stable_since = None
            elif self.bias is not None:
                drift = max(abs(mean[0] - self.bias[0]), abs(mean[1] - self.bias[1]))
                if drift / UNITS_PER_DPS >= max(p["deadzone"], r["gyro_threshold"]) * 2:
                    self.stable_since = self.stable_since or t
                    resting = t - self.stable_since > 3
                    if resting:
                        self.bias, self.stable_since = None, None
                else:
                    self.stable_since = None
        else:
            gyro_sd = accel_sd = float("nan")
            resting = False
        if resting:
            if self.bias is None:
                self.bias = mean[:2]
                log(f"Calibrated gyro offset: {mean[0]:.0f}, {mean[1]:.0f}")
            else:
                for i in range(2):
                    self.bias[i] += r["learn_rate"] * (mean[i] - self.bias[i])
        if resting != self.resting and self.debug:
            log("rest" if resting else "moving")
        if resting and not self.resting:
            self.rest_since = time.monotonic()
            if self.rest_since - self.bias_saved > 60:
                self.save_bias()
        elif not resting:
            self.rest_since = None
        self.resting = resting

        if self.debug and t - self.last_debug > 0.25:
            self.last_debug = t
            b = self.bias or (float("nan"),) * 2
            log(f"gyro RX={self.gyro[e.ABS_RX]:7d} RY={self.gyro[e.ABS_RY]:7d} RZ={self.gyro[e.ABS_RZ]:7d}"
                f"  bias=({b[0]:.0f}, {b[1]:.0f})  sd={gyro_sd:.2f}°/s accel_sd={accel_sd:.1f}"
                f"  {'REST' if resting else ''}")

        if self.bias is None or resting or self.clutch:
            self.dps = [0.0, 0.0]
            self.vel = [0.0, 0.0]
            self.frac = [0.0, 0.0]
            return
        dps = []
        for i, inv in enumerate((p["x_invert"], p["y_invert"])):
            d = (raw[i] - self.bias[i]) / UNITS_PER_DPS * (-1 if inv else 1)
            # Zona muerta suave: 0 por debajo de deadzone, rampa hasta 2×deadzone y luego el giro
            # entero (restarla siempre se comía buena parte de los giros lentos)
            dz = p["deadzone"]
            if dz > 0:
                d *= min(max((abs(d) - dz) / dz, 0.0), 1.0)
            dps.append(d)
        # Filtro 1€: corte bajo al apuntar despacio (quita el temblor de la mano) que sube con la
        # velocidad (giros rápidos sin retardo). El mismo corte en los dos ejes: las diagonales
        # no se tuercen
        cutoff = p["min_cutoff"] + p["beta"] * math.hypot(*self.dps)
        a = 1 / (1 + 1 / (2 * math.pi * cutoff * self.period)) if cutoff > 0 else 1.0
        self.dps = [prev + a * (d - prev) for prev, d in zip(self.dps, dps)]
        # Aceleración: la ganancia sube con la velocidad (lento = preciso, rápido = lejos)
        base = self.px_per_deg if p["span"] > 0 and self.px_per_deg else p["sensitivity"]
        self.vel = [d * base * (1 + p["acceleration"] * abs(d) / 100) for d in self.dps]
        self.last_report = time.monotonic()

    def step(self, now):
        """(dx, dy) en píxeles desde el último paso: integra la velocidad con el tiempo real, así
        el cursor avanza parejo aunque los informes lleguen a ráfagas."""
        dt = min(now - self.last_step, 0.05)
        self.last_step = now
        if now - self.last_report > 0.05:  # sin informes: el mando dejó de enviar
            self.vel = [0.0, 0.0]
        if not self.moving:
            return None
        out = []
        for i in range(2):
            self.frac[i] += self.vel[i] * dt
            whole = int(self.frac[i])
            self.frac[i] -= whole
            out.append(whole)
        return tuple(out) if any(out) else None


class AirMouse:
    def __init__(self, config_path, debug):
        self.config_path, self.debug = config_path, debug
        self.cfg = load_config(config_path)
        self.pointer = Pointer(self.cfg, debug)
        self.devices = {}  # papel → InputDevice
        self.hid = None
        self.pressed = set()  # códigos pulsados en el dispositivo virtual
        self.reload = False
        self.running = True
        # Cursor Wii mientras se usa el mando; vuelve al normal al mover el ratón
        self.wii_cursor = False
        self.last_motion = 0.0  # último movimiento enviado por el mando
        self.travel = 0         # px movidos por el mando seguidos (para pasar a Wii)
        self.emitted = 0        # px enviados por el mando desde la última consulta
        self.last_pos = None    # posición del cursor en la última consulta
        self.last_poll = 0.0
        self.missing_theme_logged = False
        self.normal = None      # tema normal guardado al pasar a Wii
        self.pending = {}       # botones con la acción en espera (mantener o combinación) → pulsación
        self.holding = set()    # botones cuya acción de mantener está activa
        self.late = set()       # botones de combinación que ya hicieron su acción normal
        self.chord = None       # (botones, acción) de la combinación en curso
        self.swallow = set()    # botones de una combinación ya terminada: se ignora su soltar
        self.profile = 0
        try:
            saved = STATE.read_text().strip()
            names = [prof["name"] for prof in self.cfg["profile_list"]]
            self.profile = names.index(saved) if saved in names else 0
        except OSError:
            pass
        self.game = None        # juego enfocado (clave de cfg["games"]) → modo juego
        self.layer = None       # perfil efectivo: el elegido, con el mando virtual encima en juegos
        self.build_layer()
        self.pad = None         # mando virtual (se crea la primera vez que hace falta)
        self.events = None      # socket2 de Hyprland (foco de ventana), solo si hay juegos
        self.events_buf = b""
        self.active = ["", "", ""]  # ventana enfocada: dirección, clase, título
        self.last_events_try = 0.0
        self.width = None       # ancho del escritorio usado para pointer.span
        self.asleep = False     # sensores de movimiento apagados (ahorro de batería)
        self.last_use = time.monotonic()  # último botón o movimiento del mando
        self.last_battery = 0.0
        self.battery_warned = False
        self.last_monitors = 0.0
        keys = set(range(e.KEY_ESC, e.KEY_MICMUTE + 1)) | {e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE}
        try:
            self.ui = evdev.UInput({e.EV_KEY: sorted(keys), e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL]},
                                   name="Wiimote Air Mouse")
        except (OSError, evdev.UInputError) as err:
            log(f"Cannot open /dev/uinput ({err}). Install 70-wiimote-airmouse.rules in udev")
            sys.exit(1)

    def connect(self, hid, roles):
        self.hid, self.devices = hid, {}
        self.pointer.reset()
        self.last_use, self.last_battery, self.battery_warned = time.monotonic(), 0.0, False
        self.add(roles, quiet=True)
        log(f"Wiimote connected ({', '.join(sorted(self.devices))}), profile {self.current['name']}")
        self.show_leds()
        if self.cfg["ui"]["ipc"]:
            run_command(str(KEYBOARD))  # vía Hyprland: necesita el entorno de Wayland
        if "gyro" not in self.devices:
            log("Waiting for MotionPlus (gyro) ...")

    def add(self, roles, quiet=False):
        for role, dev in roles.items():
            if role in self.devices or (self.asleep and role in MOTION_ROLES):
                dev.close()
                continue
            if role == "buttons":
                try:
                    dev.grab()  # que Hyprland no reciba también las teclas originales
                except OSError as err:
                    log(f"Could not grab the buttons device: {err}")
            self.devices[role] = dev
            if not quiet:
                log(f"Wiimote {role} ready")

    def disconnect(self):
        for dev in self.devices.values():
            try:
                dev.close()
            except OSError:
                pass
        self.devices, self.hid = {}, None
        self.asleep = False
        self.release_all()
        keyboard_send("quit")
        self.set_wii_cursor(False)
        log("Wiimote disconnected, waiting for it to reconnect ...")

    def scan(self):
        groups = find_wiimotes()
        if self.hid is None:
            # El primero con botones; el resto de grupos se cierra
            chosen = next((h for h, g in groups.items() if "buttons" in g), None)
            for hid, roles in groups.items():
                if hid == chosen:
                    self.connect(hid, roles)
                else:
                    for dev in roles.values():
                        dev.close()
        else:
            for hid, roles in groups.items():
                if hid == self.hid:
                    self.add(roles)
                else:
                    for dev in roles.values():
                        dev.close()

    @property
    def current(self):
        return self.layer

    def build_layer(self):
        """Perfil efectivo. En un juego, los botones del [gamepad] van al mando virtual; los
        demás (Home) conservan su acción y su hold, y las combinaciones del perfil se desactivan."""
        prof = self.cfg["profile_list"][self.profile]
        if self.game not in self.cfg["games"]:
            self.game, self.layer = None, prof
            return
        actions, chords, _ = self.cfg["games"][self.game]
        self.layer = {"name": f"{prof['name']} (game)", "actions": {**prof["actions"], **actions},
                      "hold": {c: a for c, a in prof["hold"].items() if c not in actions},
                      "chords": chords}

    def gamepad(self):
        if self.pad is None:
            axis = evdev.AbsInfo(value=0, min=-32768, max=32767, fuzz=16, flat=128, resolution=0)
            try:
                # Ejes quietos: sin ellos algunos juegos (SDL) no lo reconocen como mando
                self.pad = evdev.UInput({e.EV_KEY: PAD_BUTTONS, e.EV_ABS: [(e.ABS_X, axis), (e.ABS_Y, axis)]},
                                        name="Wiimote Gamepad")
            except (OSError, evdev.UInputError) as err:
                log(f"Cannot create the virtual gamepad: {err}")
                self.pad = False
        return self.pad

    def emit_key(self, code, value):
        dev = self.gamepad() if code in PAD_BUTTONS else self.ui
        if not dev:
            return
        dev.write(e.EV_KEY, code, value)
        dev.syn()
        (self.pressed.add if value else self.pressed.discard)(code)
        if code == e.BTN_LEFT and value and KEYBOARD_SOCK.exists():
            keyboard_send("click")  # el teclado en pantalla solo se abre tras un clic

    def set_game(self, window_class, title=""):
        """Foco en otra ventana: modo juego si su clase contiene una de la lista [gamepad]
        (y su título cumple gamepad.<juego>.title, si lo tiene)."""
        cls = window_class.lower()
        game = next((g for g, (_, _, rx) in self.cfg["games"].items()
                     if g and g in cls and (rx is None or rx.search(title))), None)
        if game == self.game:
            return
        self.release_all()
        self.game = game
        self.build_layer()
        log(f"Game mode on ({game})" if game else "Game mode off")
        subprocess.Popen(["notify-send", "-a", "Wiimote", "-t", "1500", "-h",
                          "string:x-canonical-private-synchronous:wiimote-profile", "Wiimote",
                          f"Gamepad: {game}" if game else f"Profile: {self.current['name']}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def watch_focus(self):
        """Conecta al socket2 de Hyprland (eventos de foco) si hay juegos configurados."""
        if not self.cfg["games"]:
            if self.events:
                self.events.close()
                self.events = None
            self.set_game("")
            return
        if self.events or time.monotonic() - self.last_events_try < SCAN_INTERVAL:
            return
        self.last_events_try = time.monotonic()
        sig = hypr_signature()
        if not sig:
            return
        path = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr" / sig / ".socket2.sock"
        sock = socket.socket(socket.AF_UNIX)
        try:
            sock.connect(str(path))
        except OSError:
            sock.close()
            return
        self.events, self.events_buf = sock, b""
        try:
            win = json.loads(hypr_request("j/activewindow") or "{}")
        except ValueError:
            win = {}
        self.active = [win.get("address", "").removeprefix("0x"), win.get("class", ""), win.get("title", "")]
        self.set_game(*self.active[1:])

    def on_events(self):
        try:
            data = self.events.recv(65536)
        except OSError:
            data = b""
        if not data:  # Hyprland se cerró o reinició: se reconecta en watch_focus
            self.events.close()
            self.events = None
            self.set_game("")
            return
        *lines, self.events_buf = (self.events_buf + data).split(b"\n")
        for line in lines:
            name, _, arg = line.decode(errors="replace").partition(">>")
            # El título puede cambiar sin cambiar el foco (Dolphin al arrancar el juego)
            if name == "activewindowv2":  # dirección sin 0x
                self.active[0] = arg
            elif name == "activewindow":  # "clase,título" ("," si no hay ventana)
                self.active[1:] = arg.split(",", 1)
                self.set_game(*self.active[1:])
            elif name == "windowtitlev2":  # "dirección,título"
                addr, _, title = arg.partition(",")
                if addr == self.active[0]:
                    self.active[2] = title
                    self.set_game(*self.active[1:])

    def release_all(self):
        """Suelta todo lo que esté en curso (al desconectar o cambiar de perfil)."""
        if self.chord and self.chord[1][0] == "wsdrag":
            ui_call(self.cfg, "wsdrag", "cancel")
        for code in sorted(self.pressed, reverse=True):
            self.emit_key(code, 0)
        self.pending, self.holding, self.late, self.chord, self.swallow = {}, set(), set(), None, set()
        self.pointer.clutch = False

    def on_button(self, ev):
        if ev.type != e.EV_KEY or ev.value == 2:  # la repetición la hace el compositor
            return
        code, prof = ev.code, self.current
        if self.debug:
            name = next((n for n, c in SOURCES.items() if c == code), code)
            log(f"button {name} {'down' if ev.value else 'up'}")
        self.last_use = time.monotonic()
        if self.asleep and ev.value == 1:
            self.wake()
            self.swallow.add(code)  # la pulsación que despierta no hace su acción
            return
        action = prof["actions"].get(code)
        # Solo espera a la combinación si el otro botón puede llegar después: uno con acción de
        # mantener va siempre primero (b+left = mantener B y pulsar ←), así ← no se retrasa
        in_chord = any(code in chord and any(c not in prof["hold"] for c in chord - {code})
                       for chord in prof["chords"])
        if ev.value == 1:
            if self.chord:
                return
            # Combinación: el otro botón sigue en espera (aún no hizo nada) → empieza la combinación.
            # Si ya se mantiene (B con el embrague) también, salvo que este tenga acción de mantener;
            # su acción de mantener sigue activa y se puede repetir la combinación sin soltarlo
            held_ok = code not in prof["hold"]
            for chord, chord_action in prof["chords"].items():
                if code in chord and all(c in self.pending or (held_ok and c in self.holding)
                                         for c in chord - {code}):
                    for c in chord:
                        self.pending.pop(c, None)
                    self.chord = (chord, chord_action)
                    self.do_action(chord_action, 1)
                    return
            if code in prof["hold"] or in_chord:
                self.pending[code] = time.monotonic()
            elif action:
                self.do_action(action, 1)
            return
        # Soltar
        if self.chord and code in self.chord[0]:
            chord, chord_action = self.chord
            # El que se mantenía (B) no se ignora: su soltar termina su acción de mantener
            self.chord, self.swallow = None, set(chord - {code} - self.holding)
            self.do_action(chord_action, 0)
            if code in self.holding:
                self.holding.discard(code)
                self.do_action(prof["hold"][code], 0)
        elif code in self.swallow:
            self.swallow.discard(code)
        elif code in self.holding:
            self.holding.discard(code)
            self.do_action(prof["hold"][code], 0)
        elif code in self.late:
            self.late.discard(code)
            if action:
                self.do_action(action, 0)
        elif self.pending.pop(code, None) is not None:
            if action:  # pulsación corta: la acción normal entera
                self.do_action(action, 1)
                self.do_action(action, 0)
        elif action:
            self.do_action(action, 0)

    def check_holds(self):
        """Acciones en espera que ya vencieron: mantener (hold.delay_ms) o combinación (CHORD_MS)."""
        now, prof = time.monotonic(), self.current
        for code, t in list(self.pending.items()):
            if code in prof["hold"]:
                if now - t >= self.cfg["hold"]["delay_ms"] / 1000:
                    del self.pending[code]
                    self.holding.add(code)
                    self.do_action(prof["hold"][code], 1)
            elif now - t >= CHORD_MS / 1000:
                # Solo era candidato a combinación: hace su acción normal y la mantiene
                del self.pending[code]
                self.late.add(code)
                if action := prof["actions"].get(code):
                    self.do_action(action, 1)

    def do_action(self, action, value):
        kind, arg = action
        if kind == "key":
            for code in (arg if value else reversed(arg)):
                self.emit_key(code, value)
        elif kind == "clutch":
            self.pointer.clutch = bool(value)
            if self.debug:
                log("clutch on" if value else "clutch off")
        elif kind == "wsdrag":
            self.wsdrag(value)
        elif not value:
            return
        elif kind == "keys":
            self.tap(arg)
        elif kind == "exec":
            run_command(arg)
        elif kind == "dispatch":
            hypr_request(f"dispatch {arg}")
        elif kind == "profile":
            self.switch_profile(arg)
        elif kind == "keyboard":
            keyboard_send("toggle")
        elif kind == "cleartext":
            # Terminal (Claude Code, shell): fin de línea + Ctrl+U; resto: seleccionar todo + borrar
            try:
                cls = json.loads(hypr_request("j/activewindow") or "{}").get("class", "").lower()
            except ValueError:
                cls = ""
            ctrl = e.KEY_LEFTCTRL
            if any(t in cls for t in TERMINALS):
                self.tap([[ctrl, e.KEY_E], [ctrl, e.KEY_U]])
            else:
                self.tap([[ctrl, e.KEY_A], [e.KEY_BACKSPACE]])

    def tap(self, combos):
        for combo in combos:
            for code in combo:
                self.emit_key(code, 1)
            for code in reversed(combo):
                self.emit_key(code, 0)

    def wsdrag(self, value):
        """Arrastrar la ventana bajo el cursor a otro escritorio: la interfaz recibe
        wsdrag start <dirección> al pulsar, wsdrag drop al soltar y wsdrag cancel."""
        if value:
            try:
                win = json.loads(hypr_request("j/activewindow") or "{}")
                x, y = (int(float(v)) for v in hypr_request("cursorpos").split(","))
            except (AttributeError, ValueError):
                return
            (wx, wy), (ww, wh) = win.get("at", (0, 0)), win.get("size", (0, 0))
            if not (win.get("address") and wx <= x < wx + ww and wy <= y < wy + wh):
                return  # el cursor no está sobre una ventana
            cmd = ["wsdrag", "start", win["address"]]
        else:
            cmd = ["wsdrag", "drop"]
        ui_call(self.cfg, *cmd)

    def switch_profile(self, target):
        names = [prof["name"] for prof in self.cfg["profile_list"]]
        if target in ("next", "prev"):
            index = (self.profile + (1 if target == "next" else -1)) % len(names)
        elif target in names:
            index = names.index(target)
        else:
            log(f"Unknown profile '{target}' (valid: {', '.join(names)})")
            return
        self.release_all()
        self.profile = index
        self.build_layer()
        log(f"Profile {names[index]}")
        try:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.write_text(names[index] + "\n")
        except OSError:
            pass
        subprocess.Popen(["notify-send", "-a", "Wiimote", "-t", "1500", "-h",
                          "string:x-canonical-private-synchronous:wiimote-profile",
                          "Wiimote", f"Profile {index + 1}: {names[index]}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.show_leds()
        keyboard_send("profile")  # mostrar u ocultar el teclado si hay un campo de texto con foco

    def show_leds(self):
        """LED del mando = número de perfil (1–4). Sin permiso (regla udev) no hace nada."""
        if not self.hid:
            return
        for led in sorted(Path(self.hid).glob("leds/*:blue:p[0-3]")):
            try:
                (led / "brightness").write_text("1" if int(led.name[-1]) == self.profile % 4 else "0")
            except (OSError, ValueError):
                return

    def update_span(self):
        """pointer.span: px por grado según el ancho actual del escritorio."""
        now = time.monotonic()
        if now - self.last_monitors < MONITORS_INTERVAL:
            return
        self.last_monitors = now
        width = desktop_width()
        if width and width != self.width:
            self.width = width
            log(f"Desktop width {width:.0f} px")
        span = self.cfg["pointer"]["span"]
        self.pointer.px_per_deg = self.width / span if self.width and span > 0 else None

    def handle(self, role, dev):
        for ev in dev.read():
            if role == "buttons":
                self.on_button(ev)
            elif role == "accel":
                self.pointer.on_accel(ev)
            else:
                self.pointer.on_gyro(ev)

    def emit_motion(self):
        now = time.monotonic()
        move = self.pointer.step(now)
        if not move:
            return
        self.ui.write(e.EV_REL, e.REL_X, move[0])
        self.ui.write(e.EV_REL, e.REL_Y, move[1])
        self.ui.syn()
        dist = abs(move[0]) + abs(move[1])
        # Histéresis: el temblor de la mano no cambia el cursor, hace falta un recorrido
        if now - self.last_motion > 0.3:
            self.travel = 0
        self.travel += dist
        self.emitted += dist
        self.last_motion = self.last_use = now
        if self.travel >= self.cfg["cursor"]["switch_px"]:
            self.set_wii_cursor(True)

    def sleep(self):
        """Mando quieto un buen rato: apaga sus sensores de movimiento (el cursor no se mueve
        hasta pulsar un botón)."""
        for role in MOTION_ROLES:
            if dev := self.devices.pop(role, None):
                dev.close()
        self.asleep = True
        self.pointer.vel = [0.0, 0.0]
        log("Wiimote idle: motion sensors off (press a button to wake it)")

    def wake(self):
        self.asleep = False
        self.pointer.window.clear()  # el offset calibrado se conserva
        self.pointer.sums, self.pointer.sqsums = [0] * 5, [0] * 5
        self.pointer.last_t, self.pointer.rest_since = None, None
        self.scan()  # vuelve a abrir el giroscopio y el acelerómetro
        log("Wiimote awake")

    def power_off(self):
        """Desconecta el mando por Bluetooth: se apaga solo y vuelve al pulsar un botón."""
        mac = next((b.name.removeprefix("wiimote_battery_")
                    for b in Path(self.hid).glob("power_supply/wiimote_battery_*")), None)
        if not mac:
            return
        log(f"Wiimote idle for {self.cfg['power']['off_after_min']} min: turning it off")
        subprocess.run(["bluetoothctl", "disconnect", mac], capture_output=True, timeout=10)

    def check_power(self):
        pw, now = self.cfg["power"], time.monotonic()
        idle = now - self.last_use
        if self.pointer.rest_since is None and not self.asleep:
            idle = 0.0  # en la mano: no está quieto del todo
            self.last_use = now
        if self.game is None and not self.asleep and pw["sleep_after_s"] > 0 and idle >= pw["sleep_after_s"]:
            self.sleep()
        if self.game is None and pw["off_after_min"] > 0 and idle >= pw["off_after_min"] * 60:
            self.last_use = now  # un intento por periodo si no se desconecta
            self.power_off()
        if now - self.last_battery >= BATTERY_INTERVAL:
            self.last_battery = now
            self.check_battery()

    def check_battery(self):
        try:
            level = int(next(Path(self.hid).glob("power_supply/wiimote_battery_*/capacity")).read_text())
        except (StopIteration, OSError, ValueError):
            return
        low = self.cfg["power"]["low_battery"]
        if level <= low and not self.battery_warned:
            self.battery_warned = True
            log(f"Wiimote battery low ({level}%)")
            run_command(f"notify-send -i battery-low 'Wii Remote battery low' '{level}% left'")
        elif level > low + 5:
            self.battery_warned = False

    def set_wii_cursor(self, on):
        theme = self.cfg["cursor"]["theme"]
        if on == self.wii_cursor or not theme:
            return
        if on and not theme_exists(theme):
            if not self.missing_theme_logged:
                log(f"Cursor theme '{theme}' not installed")
                self.missing_theme_logged = True
            return
        if on:
            self.normal = normal_cursor(theme)  # antes de que Hyprland lo pise en gsettings
            name, size = theme, self.cfg["cursor"]["size"]
        else:
            name, size = self.normal or normal_cursor(theme), os.environ.get("XCURSOR_SIZE", "24")
        if hypr_request(f"setcursor {name} {size}") == "ok":
            self.wii_cursor, self.last_pos, self.travel, self.emitted = on, None, 0, 0
            if self.debug:
                log(f"cursor: {name} {size}")

    def poll_mouse(self):
        """En modo Wii: si el cursor se movió sin que lo moviera el mando, es el ratón."""
        now = time.monotonic()
        if now - self.last_poll < 0.05:
            return
        self.last_poll = now
        try:
            pos = tuple(int(float(v)) for v in hypr_request("cursorpos").split(","))
        except (AttributeError, ValueError):
            return
        last, emitted, self.last_pos, self.emitted = self.last_pos, self.emitted, pos, 0
        if last is None:
            return
        moved = abs(pos[0] - last[0]) + abs(pos[1] - last[1])
        # Mando quieto y el cursor se mueve, o se mueve mucho más de lo que envió el mando
        # (Hyprland aplica aceleración al dispositivo virtual: margen amplio)
        quiet = now - self.last_motion > 0.15
        if (quiet and moved >= 2) or moved > 4 * emitted + 30:
            self.set_wii_cursor(False)

    def run(self):
        log("Waiting for a Wiimote (pair it with bluetoothctl, then press any button) ...")
        last_scan = 0.0
        while self.running:
            if self.reload:
                self.reload = False
                self.cfg = load_config(self.config_path)
                self.pointer.cfg = self.cfg
                self.release_all()
                self.profile = min(self.profile, len(self.cfg["profile_list"]) - 1)
                self.build_layer()
                self.last_monitors = 0.0
                log("Config reloaded")
            # Buscar el mando, o las partes que falten (el MotionPlus aparece un poco después)
            incomplete = self.hid is None or len(self.devices) < len(ROLES) - (len(MOTION_ROLES) if self.asleep else 0)
            if incomplete and time.monotonic() - last_scan > SCAN_INTERVAL:
                last_scan = time.monotonic()
                self.scan()
            self.watch_focus()
            fds = {dev.fd: role for role, dev in self.devices.items()}
            if self.events:
                fds[self.events.fileno()] = "focus"
            try:
                timeout = (TICK if self.pointer.moving else 0.05 if self.wii_cursor or self.pending
                           else SCAN_INTERVAL if fds else 0.5)
                ready, _, _ = select.select(list(fds), [], [], timeout)
            except InterruptedError:
                continue
            if self.wii_cursor:
                self.poll_mouse()
            if self.pending:
                self.check_holds()
            if self.hid:
                self.update_span()
                self.check_power()
            for fd in ready:
                role = fds[fd]
                if role == "focus":
                    self.on_events()
                    continue
                try:
                    self.handle(role, self.devices[role])
                except OSError:  # ENODEV: mando apagado o fuera de alcance
                    self.disconnect()
                    break
            if self.hid:
                self.emit_motion()
        if self.hid:
            self.disconnect()
        self.set_wii_cursor(False)
        self.ui.close()
        if self.pad:
            self.pad.close()


def main():
    ap = argparse.ArgumentParser(description="Use a Wii Remote (MotionPlus) as an air mouse.")
    ap.add_argument("--config", type=Path, default=CONFIG, help=f"config file (default: {CONFIG})")
    ap.add_argument("--debug", action="store_true", help="print raw gyro values, rest state and buttons")
    ap.add_argument("--describe", action="store_true", help="print each profile's button map as JSON")
    args = ap.parse_args()
    if args.describe:
        with contextlib.redirect_stdout(sys.stderr):  # avisos de la config fuera del JSON
            cfg = load_config(args.config)
        describe(cfg)
        return

    mouse = AirMouse(args.config, args.debug)

    def stop(*_):
        mouse.running = False

    def reload(*_):
        mouse.reload = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGHUP, reload)
    mouse.run()


if __name__ == "__main__":
    main()
