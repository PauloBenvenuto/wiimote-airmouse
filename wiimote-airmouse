def log(msg):
    print(msg, flush=True)


def load_config(path):
    cfg = {k: dict(v) for k, v in DEFAULTS.items()}
    try:
        with open(path, "rb") as f:
            user = tomllib.load(f)
    except FileNotFoundError:
        log(f"Config {path} not found, using defaults")
        user = {}
    except (OSError, tomllib.TOMLDecodeError) as err:
        log(f"Invalid config {path}: {err}; using defaults")
        user = {}
    for section, values in user.items():
        if section not in cfg or not isinstance(values, dict):
            log(f"Unknown config section [{section}], ignored")
            continue
        for key, value in values.items():
            if section not in ("buttons", "hold", "profiles", "gamepad", "labels") and key not in cfg[section]:
                log(f"Unknown option {section}.{key}, ignored")
                continue
            cfg[section][key] = value
    p = cfg["pointer"]
    for axis in ("x_axis", "y_axis"):
        if p[axis] not in ("ABS_RX", "ABS_RY", "ABS_RZ"):
            log(f"pointer.{axis} = {p[axis]!r} is not ABS_RX/RY/RZ, using {DEFAULTS['pointer'][axis]}")
            p[axis] = DEFAULTS["pointer"][axis]
    # Perfiles: cada [profiles.X] cambia solo algunos botones de [buttons]/[hold]
    base_hold = {k: v for k, v in cfg["hold"].items() if k != "delay_ms"}
    cfg["profile_list"] = []
    for name, over in (cfg["profiles"] or {"Default": {}}).items():
        if not isinstance(over, dict):
            log(f"Profile '{name}' is not a table, ignored")
            continue
        buttons = {**cfg["buttons"], **{k: v for k, v in over.items() if k != "hold"}}
        hold = {**base_hold, **over.get("hold", {})}
        actions, chords = parse_actions(buttons)
        hold_actions, hold_chords = parse_actions(hold)
        if hold_chords:
            log(f"Profile '{name}': combinations (a+b) are not allowed in hold, ignored")
        cfg["profile_list"].append({"name": name, "actions": actions, "hold": hold_actions, "chords": chords,
                                    "specs": (buttons, hold)})
    # Modo juego: clase de ventana (en minúsculas) → (acciones, combinaciones); [gamepad."clase"]
    # cambia botones para ese juego y lo añade a la lista
    pad = cfg["gamepad"]
    base = {k: v for k, v in pad.items() if k != "games" and not isinstance(v, dict)}
    games = pad["games"] if isinstance(pad["games"], list) else []
    cfg["games"] = {}
    for game in games + [k for k, v in pad.items() if isinstance(v, dict)]:
        over = dict(pad.get(game)) if isinstance(pad.get(game), dict) else {}
        title = over.pop("title", None)  # regex: solo las ventanas con ese título (p. ej. el juego)
        try:
            title = re.compile(title) if title else None
        except (re.error, TypeError) as err:
            log(f"gamepad.{game}.title: invalid regex ({err}), ignored")
            title = None
        cfg["games"][str(game).lower()] = (*parse_actions({**base, **over}), title)
    return cfg


def parse_combo(text):
    """'KEY_LEFTCTRL+KEY_A' → [códigos], o None si algún nombre no existe."""
    codes = [e.ecodes.get(k.strip()) for k in text.split("+")]
    return codes if codes and all(isinstance(c, int) for c in codes) else None


def parse_action(spec):
    kind, _, arg = str(spec).partition(":")
    arg = arg.strip()
    if kind in ("key", "button") and (combo := parse_combo(arg)):
        return ("key", combo)
    if kind == "pad" and (combo := parse_combo(arg)) and all(c in PAD_BUTTONS for c in combo):
        return ("key", combo)  # emit_key lo manda al mando virtual
    if kind == "keys":
        combos = [parse_combo(c) for c in arg.split(",")]
        if combos and all(combos):
            return ("keys", combos)
    elif kind in ("exec", "dispatch") and arg:
        return (kind, arg)
    elif kind == "profile" and arg:
        return ("profile", arg)
    elif spec in ("clutch", "cleartext", "wsdrag", "keyboard", "none"):
        return (spec, None)
    return None


def parse_actions(buttons):
    """({código: acción}, {frozenset(códigos): acción}); acción = (tipo, argumento)."""
    actions, chords = {}, {}
    for name, spec in buttons.items():
        parts = name.split("+")
        if not all(part in SOURCES for part in parts) or len(parts) > 2:
            log(f"Unknown button '{name}' (valid: {', '.join(SOURCES)}, or two joined with +), ignored")
            continue
        action = parse_action(spec)
        if action is None:
            log(f"Invalid action for '{name}': {spec!r} (use key:, keys:, button:, pad:, exec:, dispatch:,"
                " profile:, clutch, cleartext, wsdrag or none)")
        elif action[0] != "none":
            if len(parts) == 2:
                chords[frozenset(SOURCES[x] for x in parts)] = action
            else:
                actions[SOURCES[name]] = action
    return actions, chords


